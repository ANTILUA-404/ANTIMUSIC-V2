{
  "name": "antimusic",
  "version": "3.0.0",
  "private": true,
  "description": "ANTIMUSIC v3 — Discord music bot (Discord.js 14 + yt-dlp + FFmpeg). Tanpa Lavalink/Java, 24/7 radio, whitelist lisensi, siap Pterodactyl.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "deploy": "node src/deploy-commands.js",
    "doctor": "node scripts/doctor.js",
    "check": "node scripts/check.js",
    "audio-test": "node scripts/audio-test.js",
    "install:ffmpeg": "node scripts/install-ffmpeg.js",
    "install:ytdlp": "node scripts/install-ytdlp.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test test/core.test.js"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "youtube",
    "spotify",
    "radio",
    "pterodactyl"
  ],
  "license": "MIT",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "lavalink-client": "^2.11.0",
    "opusscript": "^0.1.1"
  }
