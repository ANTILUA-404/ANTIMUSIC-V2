# ============================================================
#  ANTIMUSIC v3 - konfigurasi
#  Copy file ini menjadi .env lalu isi bagian yang wajib.
#  Engine: Discord.js 14 + yt-dlp + FFmpeg (tanpa Lavalink/Java)
# ============================================================

# ---------- WAJIB ----------
DISCORD_TOKEN=
CLIENT_ID=

# Opsional: isi ID server saat testing supaya slash command langsung muncul
# (tanpa ini, slash command global butuh ±1 jam untuk tersebar).
GUILD_ID=

# ---------- BOT ----------
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500

# Keluar otomatis saat antrean habis (detik). 0 = jangan pernah keluar.
# (IDLE_DESTROY_MS dari v2 masih diterima sebagai alias.)
IDLE_LEAVE_SECONDS=60

# Jumlah hasil yang muncul di dropdown /play.
SEARCH_RESULTS=5

# Autoplay default untuk server baru. (AUTOPLAY_DEFAULT dari v2 masih diterima.)
AUTOPLAY=false
DEFAULT_LOOP=off

# ---------- HEALTH / WEB ----------
# Di Pterodactyl biarkan kosong: otomatis memakai SERVER_PORT alokasi panel.
# Kosong di VPS = health server dimatikan.
HEALTH_PORT=

# error | warn | info | debug
LOG_LEVEL=info

# ============================================================
#  AUDIO ENGINE (yt-dlp + FFmpeg)
# ============================================================

# Biarkan kosong: bot memakai ./bin/yt-dlp kalau ada, lalu PATH.
YTDLP_PATH=

# true = unduh yt-dlp standalone ke ./bin otomatis kalau belum ada.
# Ini yang bikin bot jalan di Pterodactyl tanpa apt-get.
YTDLP_AUTO_INSTALL=true

# Kosong = pakai ./bin/ffmpeg (diunduh otomatis) atau ffmpeg dari PATH.
# Isi hanya kalau mau memakai FFmpeg sistem, contoh: /usr/bin/ffmpeg
FFMPEG_PATH=

# Cookie file format Netscape (untuk video age-restricted / private).
YTDLP_COOKIES=

# Proxy untuk yt-dlp, contoh http://127.0.0.1:8080
YTDLP_PROXY=

# Argumen extractor, contoh: youtube:player_client=web,android
YTDLP_EXTRACTOR_ARGS=

# ============================================================
#  SPOTIFY
# ============================================================
# Link Spotify SELALU bisa diputar walau bagian ini kosong: bot mengambil
# judul + artis dari halaman embed publik lalu mencarikannya di YouTube.
# Isi kredensial kalau mau playlist/album penuh (tanpa batas 50 track).
# https://developer.spotify.com/dashboard -> Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================================
#  MODE 24/7 (RADIO)
# ============================================================

# Pulihkan sesi radio otomatis setelah bot restart.
RADIO_RESTORE_ON_BOOT=true

# Jeda percobaan ulang kalau stream putus (ms), naik bertahap.
RADIO_RETRY_DELAY_MS=5000

# Batas percobaan sebelum menyerah. Stream yang sempat main >1 menit
# dihitung sebagai streak baru.
RADIO_MAX_RETRIES=10

# ============================================================
#  LISENSI / WHITELIST SERVER
# ============================================================

# true  = hanya server di daftar yang boleh memakai bot
# false = semua server bebas memakai bot
WHITELIST_ENABLED=true

# ID server Discord yang boleh memakai bot (pisahkan dengan koma).
# Kosong = semua server diizinkan sementara (mode terbuka, ada warning di log).
# Contoh: 123456789012345678,987654321098765432
WHITELIST_GUILD_IDS=

# Nama owner yang muncul di panel "Server Belum Berlisensi".
OWNER_USERNAME=xelzlovecean_33932

# Opsional: ID numerik owner supaya muncul tombol "Hubungi Owner".
# Cara dapat: aktifkan Developer Mode di Discord -> klik kanan profil -> Copy User ID.
OWNER_USER_ID=

# Keluar otomatis dari server yang tidak berlisensi.
WHITELIST_LEAVE_UNAUTHORIZED=true

# Jeda minimal antar panel penolakan di channel yang sama (ms).
WHITELIST_NOTIFY_COOLDOWN_MS=10000
