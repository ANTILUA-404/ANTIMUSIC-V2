# ============================================================
#  ANTIMUSIC - konfigurasi
#  Copy file ini menjadi .env lalu isi bagian yang wajib.
# ============================================================

# ---------- WAJIB ----------
DISCORD_TOKEN=
CLIENT_ID=

# Opsional: isi ID server saat testing supaya slash command langsung muncul
# (tanpa ini, slash command global butuh ±1 jam untuk tersebar).
GUILD_ID=

# ---------- BOT ----------
PREFIX=?
DEFAULT_VOLUME=70
MAX_QUEUE_SIZE=500

# Keluar otomatis saat antrean habis (ms). 0 = jangan pernah keluar.
IDLE_DESTROY_MS=15000

# Keluar otomatis saat voice channel kosong (ms). 0 = jangan pernah keluar.
EMPTY_CHANNEL_LEAVE_MS=30000

# Autoplay default untuk server baru.
AUTOPLAY_DEFAULT=false

# ---------- HEALTH / WEB ----------
# Di Pterodactyl biarkan kosong: otomatis memakai SERVER_PORT alokasi panel.
HEALTH_PORT=3000

# info | debug | warn | error   (debug = sangat detail)
LOG_LEVEL=info
# true = log satu baris JSON (untuk collector), false = mudah dibaca
LOG_JSON=false

# ============================================================
#  LAVALINK
# ============================================================

# true  = bot menjalankan & mengawasi Lavalink.jar sendiri (mode Pterodactyl)
# false = pakai Lavalink eksternal (isi LAVALINK_HOST ke host lain)
LAVALINK_EMBEDDED=true

LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=antimusic-super-secret
LAVALINK_SECURE=false

# RAM untuk JVM Lavalink. Kosong = otomatis dari SERVER_MEMORY panel.
LAVALINK_MEMORY_MB=
# Argumen JVM kustom (opsional, pisahkan dengan koma)
LAVALINK_JAVA_ARGS=

# Batas waktu menunggu Lavalink siap (ms). Start pertama mengunduh plugin
# YouTube sehingga bisa memakan 1-3 menit.
LAVALINK_STARTUP_TIMEOUT_MS=240000

# Restart otomatis kalau proses Lavalink mati / tidak merespons.
LAVALINK_AUTO_RESTART=true

# Timeout satu request ke Lavalink (ms). Naikkan kalau internet server lambat.
LAVALINK_REQUEST_TIMEOUT_MS=20000

# Total batas waktu satu pencarian lintas node + sumber (ms).
LAVALINK_SEARCH_BUDGET_MS=45000

# Tulis ulang lavalink/application.yml setiap start agar password & port
# selalu sama dengan .env. Matikan kalau kamu mau mengelola file itu sendiri.
LAVALINK_MANAGE_CONFIG=true

# Versi yang diunduh otomatis
LAVALINK_VERSION=4.2.2
LAVALINK_YOUTUBE_PLUGIN=1.18.2

# Client YouTube yang dipakai plugin (urutan = prioritas).
# MUSIC hanya untuk pencarian (ytmsearch), sisanya untuk playback.
# TV butuh login, jadi diganti TVHTML5_SIMPLY yang jalan tanpa OAuth.
LAVALINK_YOUTUBE_CLIENTS=MUSIC,ANDROID_VR,WEB,WEBEMBEDDED,TVHTML5_SIMPLY,MWEB

# ---------- YouTube OAuth (SANGAT DISARANKAN kalau IP server diblokir) ----------
# Gejala yang diperbaiki: "All clients failed to load the item",
# "This video requires login", "No supported audio streams available".
#
# Cara pakai:
#   1. set YOUTUBE_OAUTH_ENABLED=true
#   2. restart, lihat console: "go to https://www.google.com/device and enter code XXX-XXX"
#   3. buka link itu, login pakai akun BURNER (jangan akun utama)
#   4. setelah selesai, console menampilkan refresh token -> copy ke YOUTUBE_OAUTH_REFRESH_TOKEN
#   5. restart sekali lagi
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Alternatif OAuth: poToken (hanya untuk client WEB / WEBEMBEDDED).
# Ambil dari https://github.com/iv-org/youtube-trusted-session-generator
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# Opsional: remote cipher server (yt-cipher) untuk mengatasi
# "must find sig function from script".
YOUTUBE_REMOTE_CIPHER_URL=
YOUTUBE_REMOTE_CIPHER_PASSWORD=
YOUTUBE_REMOTE_CIPHER_USER_AGENT=ANTIMUSIC

# ============================================================
#  SPOTIFY / APPLE MUSIC / DEEZER  (plugin LavaSrc)
# ============================================================
# Link Spotify/Apple/Deezer SELALU bisa diputar walau bagian ini kosong:
# bot mengambil judul + artis dari halaman publik lalu mencarikannya di
# YouTube/SoundCloud. Isi kredensial kalau mau dukungan penuh
# (playlist, album, pencarian sp:/am:/dz:).

LAVASRC_ENABLED=true

# Urutan sumber audio untuk memutar lagu Spotify/Apple ("mirroring").
# scsearch dulu = paling aman di VPS yang diblokir YouTube.
LAVASRC_PROVIDERS=scsearch:%QUERY%,ytsearch:%QUERY%,ytsearch:"%ISRC%"

# --- Spotify (gratis, 2 menit) ---
# https://developer.spotify.com/dashboard -> Create app -> copy Client ID & Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=ID
SPOTIFY_PLAYLIST_LOAD_LIMIT=6
SPOTIFY_ALBUM_LOAD_LIMIT=6
SPOTIFY_RESOLVE_ARTISTS=true

# --- Apple Music ---
# WAJIB berupa JWT (3 bagian dipisah titik). Kalau formatnya salah, source
# Apple otomatis dimatikan supaya Lavalink tidak crash; link lagu Apple tetap
# bisa diputar lewat pencarian teks.
APPLE_MUSIC_MEDIA_API_TOKEN=
APPLE_MUSIC_COUNTRY_CODE=ID
APPLE_MUSIC_PLAYLIST_LOAD_LIMIT=6
APPLE_MUSIC_ALBUM_LOAD_LIMIT=6

# --- Deezer (opsional, butuh arl + master key) ---
DEEZER_ARL=
DEEZER_MASTER_DECRYPTION_KEY=

# ---------- NODE CADANGAN ----------
# Default OFF. Node publik pihak ketiga sering lambat / membalas
# "Proxy error" dan mengirim query kamu ke server orang lain.
LAVALINK_ENABLE_FALLBACKS=false

# Fallback kustom (JSON array). Contoh:
# LAVALINK_FALLBACKS=[{"id":"VPS-2","host":"lavalink.domainkamu.com","port":443,"authorization":"password","secure":true}]
LAVALINK_FALLBACKS=

# ============================================================
#  MODE 24/7 (RADIO)
# ============================================================

# Pulihkan sesi radio otomatis setelah bot restart.
RADIO_RESTORE_ON_BOOT=true

# Seed default kalau belum ada lagu yang pernah diputar.
RADIO_DEFAULT_SEED=lofi hip hop mix

# Query cadangan supaya radio tidak pernah kehabisan lagu.
RADIO_FALLBACK_QUERIES=lofi hip hop radio,chillhop mix,instrumental study music,acoustic covers playlist,synthwave retrowave mix

# Jumlah lagu yang di-buffer setiap pengisian ulang.
RADIO_BATCH_SIZE=15

# Jeda percobaan ulang kalau pengisian gagal (ms).
RADIO_RETRY_MS=15000

# ============================================================
#  LISENSI / WHITELIST SERVER
# ============================================================

# true  = hanya server di daftar yang boleh memakai bot
# false = semua server bebas memakai bot
WHITELIST_ENABLED=true

# ID server Discord yang boleh memakai bot (pisahkan dengan koma).
# Kosong = semua server diizinkan sementara (mode terbuka, ada warning di log).
# Contoh: 123456789012345678,987654321098765432
WHITELIST_GUILD_IDS=

# Nama owner yang muncul di panel "Server Belum Berlisensi".
OWNER_USERNAME=xelzlovecean_33932

# Opsional: ID numerik owner supaya muncul tombol "Hubungi Owner".
# Cara dapat: aktifkan Developer Mode di Discord -> klik kanan profil -> Copy User ID.
OWNER_USER_ID=

# Keluar otomatis dari server yang tidak berlisensi.
WHITELIST_LEAVE_UNAUTHORIZED=true

# Jeda minimal antar panel penolakan di channel yang sama (ms).
WHITELIST_NOTIFY_COOLDOWN_MS=10000
