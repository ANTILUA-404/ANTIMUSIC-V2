# ============================================================
#  ANTIMUSIC v3 - konfigurasi
#
#  File ini OPSIONAL kalau kamu pakai Pterodactyl: semua variabel
#  bisa diisi di tab Startup panel (tidak perlu bikin .env).
#  Untuk VPS/PC: copy file ini menjadi .env lalu isi DISCORD_TOKEN.
#
#  Engine: Discord.js 14 + yt-dlp + FFmpeg (tanpa Lavalink/Java)
# ============================================================

# ---------- WAJIB ----------
DISCORD_TOKEN=
CLIENT_ID=

# Opsional: isi ID server saat testing supaya slash command langsung muncul
# (tanpa ini, slash command global butuh ±1 jam untuk tersebar).
GUILD_ID=

# ---------- BOT ----------
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500

# Keluar otomatis saat antrean habis (detik). 0 = jangan pernah keluar.
# (IDLE_DESTROY_MS dari v2 masih diterima sebagai alias.)
IDLE_LEAVE_SECONDS=60

# Jumlah hasil yang muncul di dropdown /play.
SEARCH_RESULTS=5

# Autoplay default untuk server baru. (AUTOPLAY_DEFAULT dari v2 masih diterima.)
AUTOPLAY=false
DEFAULT_LOOP=off

# Daftarkan slash command otomatis setiap start (tidak perlu npm run deploy).
AUTO_DEPLOY_COMMANDS=true

# ---------- HEALTH / WEB ----------
# Di Pterodactyl biarkan kosong: otomatis memakai SERVER_PORT alokasi panel.
# Kosong di VPS = health server dimatikan.
HEALTH_PORT=

# error | warn | info | debug
LOG_LEVEL=info

# ============================================================
#  AUDIO ENGINE (yt-dlp + FFmpeg)
# ============================================================

# Biarkan kosong: bot memakai ./bin/yt-dlp kalau ada, lalu PATH.
YTDLP_PATH=

# true = unduh yt-dlp standalone ke ./bin otomatis kalau belum ada.
# Ini yang bikin bot jalan di Pterodactyl tanpa apt-get.
YTDLP_AUTO_INSTALL=true

# Kosong = pakai ./bin/ffmpeg (diunduh otomatis) atau ffmpeg dari PATH.
# Isi hanya kalau mau memakai FFmpeg sistem, contoh: /usr/bin/ffmpeg
FFMPEG_PATH=

# Cookie file format Netscape (untuk video age-restricted / private).
YTDLP_COOKIES=

# Proxy untuk yt-dlp, contoh http://127.0.0.1:8080
YTDLP_PROXY=

# Argumen extractor, contoh: youtube:player_client=web,android
YTDLP_EXTRACTOR_ARGS=


# ============================================================
#  AUDIO ENGINE
# ============================================================
# auto     = coba Lavalink dulu; kalau gagal, pakai yt-dlp lokal (disarankan)
# lavalink = wajib Lavalink, error kalau node tidak tersedia
# local    = selalu yt-dlp + FFmpeg (tanpa Java, tanpa server tambahan)
AUDIO_ENGINE=auto

# Kalau Lavalink mati (mis. trial Railway habis), bot tetap bisa memutar audio.
AUDIO_FALLBACK_LOCAL=true

# ---------- Lavalink (Railway / VPS) ----------
# KOSONG = engine lokal. Isi host untuk mengaktifkan Lavalink.
#
# Ada DUA jalur ke node yang sama, jangan dicampur:
#   internal (sesama project Railway, tanpa TLS, lebih cepat & hemat):
#       LAVALINK_HOST=lavalink.railway.internal
#       LAVALINK_PORT=8080            <- port container, sama dengan $PORT service Lavalink
#   publik (domain .up.railway.app, wajib TLS di port 443):
#       LAVALINK_HOST=antimusic-production-xxxx.up.railway.app
#       LAVALINK_PORT=443
#
# Skema (http/https) sekarang ditebak otomatis dari host: *.railway.internal -> http,
# *.up.railway.app -> https/443. Jadi LAVALINK_SECURE boleh dikosongkan.
# Kalau diisi, nilainya menang atas tebakan.
LAVALINK_HOST=
LAVALINK_PORT=
LAVALINK_PASSWORD=
LAVALINK_SECURE=
LAVALINK_NODE_ID=main

# Alternatif: satu URL penuh (menang atas LAVALINK_HOST/PORT/SECURE).
# LAVALINK_URL=http://lavalink.railway.internal:8080

# Sumber pencarian default: youtube | ytmsearch | soundcloud
LAVALINK_SEARCH_SOURCE=youtube

# Node lambat start (Railway cold start 30-120 detik): bot menunggu sampai
# GET /v4/info menjawab JSON sebelum menyerah dan pindah ke engine lokal.
LAVALINK_STARTUP_WAIT_MS=90000
# Batas waktu manager.init() + menunggu node connected setelah preflight lolos.
LAVALINK_CONNECT_TIMEOUT_MS=20000
LAVALINK_RETRY_AMOUNT=10
LAVALINK_RETRY_DELAY_MS=5000

# Beberapa node sekaligus (JSON array). Kalau diisi, menang atas variabel di atas.
# `url` boleh penuh (http/https) — skema & port ikut URL, `secure` opsional.
# LAVALINK_NODES=[{"id":"main","url":"http://lavalink.railway.internal:8080","password":"rahasia"},{"id":"backup","host":"xxx.up.railway.app","password":"rahasia"}]

# ============================================================
#  SPOTIFY
# ============================================================
# Link Spotify SELALU bisa diputar walau bagian ini kosong: bot mengambil
# judul + artis dari halaman embed publik lalu mencarikannya di YouTube.
# Isi kredensial kalau mau playlist/album penuh (tanpa batas 50 track).
# https://developer.spotify.com/dashboard -> Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================================
#  MODE 24/7 (RADIO)
# ============================================================

# Pulihkan sesi radio otomatis setelah bot restart.
RADIO_RESTORE_ON_BOOT=true

# Jeda percobaan ulang kalau stream putus (ms), naik bertahap.
RADIO_RETRY_DELAY_MS=5000

# Batas percobaan sebelum menyerah. Stream yang sempat main >1 menit
# dihitung sebagai streak baru.
RADIO_MAX_RETRIES=10

# ============================================================
#  LISENSI / WHITELIST SERVER
# ============================================================

# true  = hanya server di daftar yang boleh memakai bot
# false = semua server bebas memakai bot
WHITELIST_ENABLED=true

# ID server Discord yang boleh memakai bot (pisahkan dengan koma).
# Kosong = semua server diizinkan sementara (mode terbuka, ada warning di log).
# Contoh: 123456789012345678,987654321098765432
WHITELIST_GUILD_IDS=

# Nama owner yang muncul di panel "Server Belum Berlisensi".
OWNER_USERNAME=xelzlovecean_33932

# Opsional: ID numerik owner supaya muncul tombol "Hubungi Owner".
# Cara dapat: aktifkan Developer Mode di Discord -> klik kanan profil -> Copy User ID.
OWNER_USER_ID=

# Keluar otomatis dari server yang tidak berlisensi.
WHITELIST_LEAVE_UNAUTHORIZED=true

# Jeda minimal antar panel penolakan di channel yang sama (ms).
WHITELIST_NOTIFY_COOLDOWN_MS=10000
